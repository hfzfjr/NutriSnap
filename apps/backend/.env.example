# ==============================================================================
# NUTRISNAP BACKEND ENVIRONMENT VARIABLES (.env.example)
# Salin file ini menjadi: .env (di dalam apps/backend)
# ==============================================================================

# Server & URL
NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://nutrisnap:nutrisnap_secret@localhost:5432/nutrisnap_db

# Security & BYOK Encryption Vault (Wajib 64 karakter hex = 32 bytes)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session Signing Secret (Minimal 32 karakter)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=nutrisnap-super-secret-session-signing-key-minimum-32-chars

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Web Push Notifications (VAPID)
# Generate via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nutrisnap.app

# Storage Adapter (local / s3)
STORAGE_MODE=local
STORAGE_LOCAL_DIR=./storage_data

