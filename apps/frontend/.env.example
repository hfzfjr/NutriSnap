# ==============================================================================
# NUTRISNAP FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Salin file ini menjadi: .env.local (di dalam apps/frontend)
# ==============================================================================

# URL API Backend NutriSnap
# Local development: http://localhost:4000/api/v1
# Coolify production: https://api.nutrisnap.domainanda.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# URL internal network (Docker / SSR)
INTERNAL_API_URL=http://localhost:4000/api/v1

# VAPID Public Key untuk Web Push Notifications (Opsional, dari backend)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

