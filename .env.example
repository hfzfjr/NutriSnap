# ==============================================================================
# NUTRISNAP MONOREPO — ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# 1. Server & Environment
NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
INTERNAL_API_URL=http://localhost:4000/api/v1

# 2. PostgreSQL Database (Coolify / Local)
DATABASE_URL=postgresql://nutrisnap:nutrisnap_secret@localhost:5432/nutrisnap_db

# 3. Security & Encryption Vault (CRITICAL — AES-256-GCM Master Key: 64 hex chars = 32 bytes)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=nutrisnap-super-secret-session-signing-key-minimum-32-chars

# 4. Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# 5. Web Push Notifications (VAPID Keys)
# Generate via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=UUxI4O8-FbRouAevSmBQ6o18hgE4nSG3qwvJTfKc-ls
VAPID_SUBJECT=mailto:admin@nutrisnap.app

# 6. Storage (MinIO / Local Volume on Coolify)
STORAGE_MODE=local
STORAGE_LOCAL_DIR=./storage_data
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nutrisnap-foods
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

